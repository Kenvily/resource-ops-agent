# Run backend from repository root. Copy to .env; never commit real credentials.
DATA_MODE=mock
MOCK_SCENARIO=normal
# normal | partial | empty | missing | overallocated | stale
# Live: explicitly set BOTH approved Prometheus origins; see docs/OPERATIONS.md.
PROM_YZ_URL=
PROM_ZW_URL=
PROM_TIMEOUT_SECONDS=8
PROM_MAX_RESPONSE_BYTES=4000000
PROM_MAX_SERIES=10000
STALE_AFTER_SECONDS=120
# Enable ONLY after exporter completeness / no-allocation semantics are verified.
ALLOCATION_ABSENCE_IS_ZERO=false
# Agent: enable only after model/data processing authorization.
LLM_ENABLED=false
LLM_DATA_PROCESSING_AUTHORIZED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=20
INSIGHT_TIMEOUT_SECONDS=90
INSIGHT_MAX_TOOL_CALLS=24
INSIGHT_MAX_MODEL_ROUNDS=6
INSIGHT_ALLOWED_CLUSTERS=["yz","zw"]

# Set only after confirming metadata/platform definitions for both clusters.
MEMORY_CAPACITY_UNIT=unverified
MEMORY_ALLOCATION_UNIT=unverified

# Bounded caches. Manual refresh also observes server-side collection cooldown.
PROM_CACHE_TTL_SECONDS=15
PROM_STALE_RETENTION_SECONDS=300
RANGE_CACHE_TTL_SECONDS=30
RANGE_MAX_POINTS=721
# Explicit gateway hostnames must be added before controlled internal deployment.
ALLOWED_HOSTS=["127.0.0.1","localhost","test"]

# Local native instance: .venv/bin/python scripts/postgres-local.py init (see docs/OPERATIONS.md).
# PostgreSQL is opt-in for existing installations; leave empty for Prometheus-only history.
# Use separate databases for Mock/Live. Do not commit credentials. See docs/OPERATIONS.md.
HISTORY_DATABASE_URL=
# Used only by deploy/compose.postgres.yml; set a strong password before starting it.
HISTORY_POSTGRES_PASSWORD=
# With PostgreSQL configured, both current resources and history are read from the database.
SNAPSHOT_SYNC_INTERVAL_SECONDS=30
HISTORY_SYNC_ENABLED=false
HISTORY_SYNC_INTERVAL_SECONDS=60
HISTORY_CHUNK_POINTS=30
HISTORY_QUERY_FILL_CHUNKS=2

# Server-side protection; frontend button state is not a rate limit.
SNAPSHOT_REFRESH_MIN_INTERVAL_SECONDS=5
HISTORY_FILL_COOLDOWN_SECONDS=30
API_REQUESTS_PER_MINUTE=60
API_REQUEST_BURST=30

# 低效占用调查：固定 DCGM 整卡/HAMi 容器 + kube-state-metrics 模板；需 PostgreSQL schema 12。
# 独立分钟采集，保留 2 天；评估只读数据库，不因点击触发 Prometheus 请求。
EFFICIENCY_ENABLED=false

# 仅在按设备型号、驱动/HAMi 版本验证容器 SM 采集后配置精确 device_type 值。
# 留空时仍采集原值与显存/kernel 信号，但不以容器零值判定任务低使用。
EFFICIENCY_VERIFIED_DEVICE_MODELS=[]

# 只读 DCGM/K8s 固定指标采集；缺测不解释为健康。需 PostgreSQL。
OPERATIONS_METRICS_ENABLED=false
# 温度阈值为运营关注线，需结合目标设备规格确认，不代表硬件损坏。
OPERATIONS_GPU_TEMPERATURE_C=85

# 实际使用历史每轮每集群最多补多少个小时桶；范围1-12，仍受共享并发和超时限制。
RESOURCE_BACKFILL_HOURS_PER_TICK=6
# 业务模型：不配置则保留库内映射；显式 [] 关闭当前映射并保留历史版本。
# RESOURCE_MODEL_MAPPINGS=[{"cluster":"yz","namespace_name":"demo","pod_name":"demo-model-0","container_name":"worker","model_key":"demo-model","display_name":"示例模型"}]

# GPU 节点主机指标：固定 CPU/MemAvailable/MemTotal/DMI 模板，需 schema 12。
HOST_METRICS_ENABLED=false
# GPU 节点上的普通容器 CPU/working set 与 requests/limits，需 schema 12。
WORKLOAD_METRICS_ENABLED=false
# 调查反馈为本机开发元数据写入，不代表认证或审计；默认关闭。
INVESTIGATION_FEEDBACK_ENABLED=false

# R3 本机评估/报告留存、复核与问题核查；默认关闭，需 PostgreSQL
OPERATIONS_WORKSPACE_ENABLED=false

# R5: default local development; production requires an approved authenticated gateway.
PRODUCTION_MODE=false
PRODUCTION_PUBLIC_ORIGIN=
GATEWAY_SHARED_SECRET=
# Production additionally requires HISTORY_QUERY_FILL_CHUNKS=0,
# explicit ALLOWED_HOSTS, and both human-write switches disabled; see OPERATIONS.

# 业务模型分类与名称规则（独立 JSON；修改后重启后端）。Mock 演示请使用脱敏配置。
RESOURCE_MODEL_CATALOG_FILE=

# 匿名第一方使用统计（需 PostgreSQL，不记录 IP、原始 URL、问题或业务标签）
ANALYTICS_ENABLED=true
