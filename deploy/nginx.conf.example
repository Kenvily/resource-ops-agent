# Template only: private TLS, approved access group and a secret file are required.
# Backend: PRODUCTION_MODE=true, PRODUCTION_PUBLIC_ORIGIN=https://roc.internal.example:8443
# ALLOWED_HOSTS=["roc.internal.example"], localhost bind, --no-proxy-headers, single worker.
# Replace Basic auth with the approved enterprise gateway before company-wide deployment.
server {
    listen 127.0.0.1:8443 ssl;
    server_name roc.internal.example;
    ssl_certificate /etc/nginx/tls/internal.crt;
    ssl_certificate_key /etc/nginx/tls/internal.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    auth_basic "Resource Operations Center";
    auth_basic_user_file /etc/nginx/secrets/roc-users.htpasswd;
    access_log off;
    error_log /var/log/nginx/roc-error.log crit;
    client_max_body_size 16k;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;

    # Both NDJSON agents need buffering disabled and a timeout above their budget.
    location ~ ^/api/v1/(insights/diagnose|efficiency/diagnose)$ {
        proxy_pass http://127.0.0.1:17979;
        include /etc/nginx/secrets/roc-upstream.conf;
        proxy_connect_timeout 3s;
        proxy_read_timeout 130s;
        proxy_send_timeout 10s;
        proxy_buffering off;
    }
    location / {
        proxy_pass http://127.0.0.1:17979;
        include /etc/nginx/secrets/roc-upstream.conf;
        proxy_connect_timeout 3s;
        proxy_read_timeout 35s;
        proxy_send_timeout 10s;
    }
}
# The private include MUST overwrite incoming values, not pass a client's token:
# proxy_set_header X-ROC-Gateway-Token "same generated secret as GATEWAY_SHARED_SECRET";
# proxy_set_header Host $http_host;
# proxy_set_header X-Forwarded-Proto "";
# proxy_set_header X-Forwarded-For $remote_addr;
# proxy_set_header Forwarded "";
# Never commit the real include or token. A transport token is not a user's identity.
